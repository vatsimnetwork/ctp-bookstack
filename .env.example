APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_GENERATED_APP_KEY
APP_URL=https://docs.example.com/bookstack/
APP_LANG=en
APP_PROXIES=*

DB_CONNECTION=mysql
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_DATABASE=bookstack
DB_USERNAME=bookstack_user
DB_PASSWORD=replace_with_strong_password

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE_NAME=bookstack_session
SESSION_SECURE_COOKIE=true

AUTH_METHOD=standard
AUTH_AUTO_INITIATE=false

CTP_AUTH_URL=http://auth-internal:3000
CTP_AUTH_PUBLIC_URL=https://auth.example.com
CTP_INTERNAL_API_KEY=replace_with_long_random_secret
